# Copia este archivo a .env (nunca commitees .env): cp .env.example .env
# Lo leen Spring (con ./mvnw spring-boot:run) y Docker Compose (docker-compose.yml).

# Opcional: sin clave, el asistente funciona con reglas (regex).
ANTHROPIC_API_KEY=

# Modelo del asistente y tope de llamadas por día.
PETFINDER_IA_MODELO=claude-sonnet-5
PETFINDER_IA_TOPE_DIARIO=200

# Puerto HTTP local (Render define el suyo).
PORT=8080

# Base de datos de docker-compose.yml (PostgreSQL). Cambia la clave.
POSTGRES_DB=petfinder
POSTGRES_USER=petfinder
POSTGRES_PASSWORD=cambie-esta-clave
